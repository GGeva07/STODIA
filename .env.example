# Copiar a .env. install.ps1 / install.sh lo generan; tambien sirve como plantilla de respuestas
# para instalacion desatendida:  install.ps1 -Config respuestas.env   |   sh install.sh --config respuestas.env
# Valores entre comillas simples; no usar comilla simple dentro de un valor. El archivo de respuestas contiene
# secretos: borrarlo tras instalar (respuestas*.env esta en .gitignore).
# URL con la que el NAVEGADOR llega a la API (http://host:3000), o /api para servirla tras el proxy de la web.
API_URL='http://localhost:3000'
INSTITUTION_NAME='Colegio Los Pinos'
TAX_ID='131556782'            # RNC, 9 digitos
ADDRESS='Av. Los Proceres #45'
CITY='Santo Domingo, Distrito Nacional'
PHONE='809-555-0100'
CONTACT_EMAIL='contacto@colegio.edu.do'
ADMIN_NAME='Nombre Apellido'
ADMIN_USER='admin'
# Minimo 8 caracteres. Vacio en modo desatendido = el instalador genera una y la muestra una vez.
# Solo se usa en el primer arranque; el instalador la borra del .env tras comprobar /health.
ADMIN_PASSWORD=''
# PIN de supervisor, 4 a 8 caracteres. Vacio = el instalador genera 6 digitos y los muestra una vez. Idem: se borra tras el arranque.
SUPERVISOR_PIN=''
# Clave firmada que entrega STODIA (STODIA1.…); define plan, módulos, cuotas y vencimiento.
LICENSE_KEY=''
WEB_PORT='8080'
API_PORT='3000'
# Origen(es) de la web permitidos por CORS (coma). Si se omite, el instalador usa http(s)://<host de API_URL>:<WEB_PORT>.
CORS_ORIGIN='http://localhost:8080'
TIMEZONE='America/Santo_Domingo'
CURRENCY='DOP'
# --- Correo saliente (opcional; el instalador lo configura solo si SMTP_HOST tiene valor) ---
# SMTP_HOST='smtp.ejemplo.com'
# SMTP_PORT='587'
# SMTP_USER=''
# SMTP_PASS=''
# SMTP_FROM='contacto@colegio.edu.do'
# --- Los escribe el instalador (no van en el archivo de respuestas) ---
# TRUST_PROXY: 'true' solo con API_URL=/api (la API va tras el proxy nginx de la web); API_BIND=127.0.0.1 en ese caso.
TRUST_PROXY='false'
API_BIND='0.0.0.0'
# Aleatorio; se conserva al reinstalar. SEED_DEMO=false: solo se crea el admin real, sin usuarios demo.
JWT_SECRET='change-me-generate-a-long-random-string'
SEED_DEMO='false'
