{
  "name": "@stodia/desktop",
  "productName": "STODIA",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación de escritorio STODIA: lleva la interfaz y se conecta a la API del colegio.",
  "author": "STODIA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:web": "pnpm --filter @stodia/web build",
    "dist:win": "pnpm run build:web && electron-builder --win nsis",
    "dist:linux": "pnpm run build:web && electron-builder --linux AppImage",
    "dist:dir": "pnpm run build:web && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25"
  },
  "build": {
    "appId": "do.stodia.desktop",
    "productName": "STODIA",
    "executableName": "stodia",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "setup.js",
      "build/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "STODIA-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "STODIA"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "artifactName": "STODIA-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ]
  }
}
