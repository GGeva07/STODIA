{
  "name": "@stodia/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma db push --skip-generate && tsx src/seed-dev.ts && tsx watch src/server.ts",
    "db:push": "prisma db push --skip-generate",
    "seed": "tsx src/seed.ts",
    "seed:dev": "tsx src/seed-dev.ts",
    "seed:demo-grande": "tsx src/seed-demo-grande.ts",
    "seed:demo-grande:quitar": "tsx src/seed-demo-grande.ts --quitar",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/license-core.test.ts",
    "db:schema:sqlserver": "node scripts/gen-schema.mjs sqlserver",
    "db:schema:sqlite": "node scripts/gen-schema.mjs sqlite",
    "db:generate": "prisma generate",
    "db:generate:sqlite": "node scripts/gen-schema.mjs sqlite && prisma generate --schema prisma/schema.sqlite.prisma",
    "db:push:sqlite": "node scripts/gen-schema.mjs sqlite && prisma db push --skip-generate --schema prisma/schema.sqlite.prisma",
    "db:migrar": "tsx scripts/migrar-sqlite-a-sqlserver.ts",
    "seed:catalogos": "tsx src/seed-catalogos.ts",
    "db:fk:auditar": "tsx scripts/fk-auditar.ts",
    "db:fk:reparar": "tsx scripts/fk-reparar.ts",
    "db:baseline": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "nodemailer": "^10.0.16",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@stodia/shared": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/nodemailer": "^8.0.2",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
