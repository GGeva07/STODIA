DATABASE_URL="file:./dev.db"
JWT_SECRET=dev-only-secret-change-me
# Modo dev: siembra demo (usuarios del prototipo, contrasena = SEED_PASSWORD)
SEED_DEMO=true
SEED_PASSWORD=stodia123
# Demo grande (solo con SEED_DEMO=true; nunca en produccion): DEMO_SCALE=large siembra ~786 alumnos activos, cartera, recibos, becas y comedor
# (seed-demo-grande.ts; determinista e idempotente). Quitarlo: pnpm --filter @stodia/api seed:demo-grande:quitar. Rehacerlo: pnpm --filter @stodia/api seed:demo-grande.
DEMO_SCALE=large
PORT=3000
# Clave firmada STODIA1.* (la emite el proveedor; define plan, módulos, cuotas y vencimiento). Con SEED_DEMO=true y vacía se usa la clave de ejemplo de desarrollo.
LICENSE_KEY=
# Produccion (SEED_DEMO=false): el admin real se crea con estas variables (las escribe el instalador)
# ADMIN_USER=admin
# ADMIN_NAME=Administrador
# ADMIN_PASSWORD=
# INSTITUTION_NAME= TAX_ID= ADDRESS= CITY= PHONE= CONTACT_EMAIL= CURRENCY=DOP TIMEZONE=America/Santo_Domingo
# PIN de supervisor (hash scrypt en SisConfig 'supervisor'). Env = solo valor INICIAL del seed; luego se cambia en Configuracion.
# Demo/dev sin definirlo: 1234. Produccion sin definirlo: no hay PIN hasta que el Super Admin lo configure.
# SUPERVISOR_PIN=
# CORS (produccion): origen(es) de la web separados por coma, p. ej. http://192.168.1.10:8080. La app movil (https://localhost, capacitor://localhost) siempre se permite.
# CORS_ORIGIN=
# TRUST_PROXY (por defecto false): true solo si la API va detras del proxy nginx de la web (API_URL=/api); entonces req.ip usa X-Forwarded-For. Tambien admite un numero de saltos (1).
# TRUST_PROXY=false
# Correo saliente (opcional)
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_FROM=
