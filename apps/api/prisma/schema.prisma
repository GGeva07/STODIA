generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// =====================================================================================================================
// REGLAS DE INTEGRIDAD (Fase 1 de docs/db-relaciones.md)
//  - Toda referencia a una entidad es una FK REAL al id interno (nunca al nombre, cedula o codigo).
//  - onUpdate: NoAction siempre (los ids no se editan; Cascade en update provoca "multiple cascade paths" en SQL Server).
//  - onDelete: NoAction (Prisma + SQL Server no admiten Restrict; en SQLite NoAction equivale) para TODO lo financiero, fiscal,
//    academico, auditoria y documentos con valor propio. Un alumno/tutor con historial NO se borra: se desactiva (estado).
//  - Cascade SOLO en PersExpediente / PersDocumento (y MobNota, tabla demostrativa) respecto del Alumno, y en las lineas de una venta.
//  - SetNull en logs/historial que sobreviven a su referencia (ComLectura.alumnoId, CmnMensaje.tutorId, Tutor.userId).
//  - El grafo de Cascade/SetNull es un bosque: ningun modelo se alcanza por dos caminos en cascada (error 1785 de SQL Server).
//  - UNIQUE sobre columnas opcionales = indices FILTRADOS creados por src/lib/db-indices.ts (SQL Server solo admite un NULL en un UNIQUE normal).
//  - FASE 2A (nucleo academico): grados, tandas, aulas, secciones, materias, rubricas, docentes y empleados ya son TABLAS TIPADAS con los
//    mismos ids de texto que tenian en Catalogo; Alumno, nomina, notas, asignaciones, horarios y extracurriculares apuntan a ellas con FK real.
//  - FASE 2B (resto de catalogos): cajas, rutas, tipos y conceptos de beca, metodos de pago, comidas, dietas y alergias tambien son TABLAS TIPADAS
//    (mismos ids de texto); Catalogo queda VACIA (se retira en la Fase 2C). Las banderas posicionales y las listas en texto pasan a tablas puente:
//    AliPlanComida / AliPlanDieta / AlumnoAlergia / AliMenuAlergia / FinBecaConcepto.
//  - FASE 2C (cierre de la base): Ciclo lectivo como ENTIDAD (Ciclo + PeriodoAcademico + Matricula), historial real del alumno por ciclo,
//    TutorAlumno (N:M con rol y vigencia), FinReciboItem / FinReciboPago (reemplazan los JSON del recibo), ServicioAlumno (4 FK de catalogo con CHECK),
//    Monedero unico (+ movimientos), FinPlanTanda, TipoDocumento; Catalogo se ELIMINA. Todo lo que es "por ciclo" lleva cicloId (FK a Ciclo).
//    NO son por ciclo: catalogos (grados, materias, aulas...), usuarios, licencia/configuracion, auditoria, planes de pago (plantillas), comedor
//    (AliPlan/AliMenu/ComCarnet), lecturas del lector (ComLectura), monedero, accesos del portal y la ficha del expediente (PersExpediente).
//  - Puentes puros (DocenteMateria, MateriaGrado, SeccionMateria, DocenteSeccion, AsignacionAula, AcadExtraGrado, RubricaCriterio): Cascade solo
//    hacia el padre "dueño" (docente, materia, seccion, asignacion, extra, rubrica); hacia el catalogo referenciado NoAction.
// =====================================================================================================================

model User {
  id           String @id @default(cuid()) @db.NVarChar(100)
  usuario      String @unique @db.NVarChar(100)
  nombre       String
  rol          String
  passwordHash String
  estado       String @default("Activo")
  /// Contraseña temporal: obliga a cambiarla en el primer ingreso.
  mustChange   Boolean @default(false)
  // Cuenta del portal del tutor (a lo sumo una por tutor: indice unico filtrado UX_Tutor_userId).
  tutores      Tutor[]
  mensajes     CmnMensaje[]
  recibos      FinRecibo[]
  ventas       FinVenta[]
  /// Notas de credito / debito emitidas por este usuario.
  notas        NotaFiscal[]
  /// Cuadres (cierres de turno) hechos por este cajero.
  cierresTurno CierreTurno[]
  // Docente / Empleado con esta cuenta (a lo sumo uno de cada tipo: indices unicos filtrados UX_Docente_userId / UX_Empleado_userId).
  docentes     Docente[]
  empleados    Empleado[]
  /// Pagos del portal que esta cuenta resolvio (confirmar / rechazar).
  intencionesResueltas MobPagoIntencion[]
  /// Imagen de firma para documentos (cajero / director / docente). A lo sumo una por usuario.
  firma        UserFirma?
}

/// Firma manuscrita escaneada de un usuario firmante. Se guarda en la BD (no en disco). `data` = bytes de un PNG/JPG/WebP (max ~300 KB).
model UserFirma {
  userId    String   @id @db.NVarChar(100)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mime      String   @db.NVarChar(40)
  data      Bytes
  updatedAt DateTime @updatedAt
  updatedBy String   @db.NVarChar(100)
}

model Tutor {
  id         String   @id @db.NVarChar(100)
  nombre     String
  /// Cedula normalizada: SOLO digitos (11), UNIQUE. La presentacion con guiones (000-0000000-0) la da lib/tutor-datos.fmtCed.
  cedula     String   @unique @db.NVarChar(100)
  parentesco String
  tipo       String
  tel        String
  email      String?
  rnc        String?
  /// Comprobante fiscal habitual de la cuenta (tipo LOGICO: CREDITO_FISCAL | CONSUMO | GUBERNAMENTAL | REGIMEN_ESPECIAL); NULL = Consumo. Preselecciona el tipo en Cobros.
  comprobanteHabitual String?
  /// Cuenta de login del portal (User.id). NULL = sin acceso al portal.
  userId     String?  @db.NVarChar(100)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  estado     String   @default("Activo")
  /// Alumnos de los que es tutor FINANCIERO (un solo tutor financiero vigente por alumno: Alumno.tutorId).
  alumnos      Alumno[] @relation("TutorFinanciero")
  /// Alumnos de los que es tutor LEGAL (Alumno.tutorLegalId).
  alumnosLegal Alumno[] @relation("TutorLegal")
  cobros       FinCobroItem[]
  recibos      FinRecibo[]
  notas        NotaFiscal[]
  intenciones  MobPagoIntencion[]
  mensajes     CmnMensaje[]
  /// Vinculos N:M con alumnos (rol + vigencia): la FUENTE de verdad. Alumno.tutorId / tutorLegalId son su copia vigente (se mantienen con lib/tutor-alumno).
  vinculos     TutorAlumno[]

  @@index([userId])
}

model Alumno {
  id        String  @id @db.NVarChar(100)
  code      String  @unique @db.NVarChar(100)
  nombres   String
  apellidos String
  fnac      String
  /// Seccion (grado + letra + tanda) del alumno: reemplaza el trio de texto grado/sec/tanda (ambiguo entre niveles). Se muestran calculados.
  /// Seccion del ciclo ACTIVO (copia de Matricula del ciclo activo, que es la fuente de verdad del historial). Se mantiene con lib/matricula.
  seccionId String  @db.NVarChar(100)
  seccion   Seccion @relation(fields: [seccionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cuenta    String
  estado    String
  dir       String  @default("")
  tel       String  @default("")
  /// Tutor FINANCIERO VIGENTE (obligatorio: un alumno no puede quedar sin responsable de pago). Copia de TutorAlumno (rol Financiero, vigente).
  tutorId   String  @db.NVarChar(100)
  tutor     Tutor   @relation("TutorFinanciero", fields: [tutorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Tutor LEGAL VIGENTE (opcional; igual al financiero cuando son la misma persona). Copia de TutorAlumno (rol Legal, vigente).
  tutorLegalId String? @db.NVarChar(100)
  tutorLegal   Tutor?  @relation("TutorLegal", fields: [tutorLegalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // 1 Alumno : 0..1 AcadRoster. Unicidad de AcadRoster.alumnoId = indice unico FILTRADO (WHERE alumnoId IS NOT NULL) creado por src/lib/db-indices.ts.
  rosters       AcadRoster[]
  expediente    PersExpediente?
  documentos    PersDocumento[]
  servicios     ServicioAlumno[]
  inscripciones PersInscripcion[]
  contratos     Contrato[]
  monedero      Monedero?
  matriculas    Matricula[]
  vinculos      TutorAlumno[]
  notasMov      MobNota[]
  accesos       MobAcceso[]
  intenciones   MobPagoIntencion[]
  carnet        ComCarnet?
  lecturas      ComLectura[]
  cobros        FinCobroItem[]
  becas         FinBeca[]
  /// Alergias del alumno (N:M con el catalogo Alergia): reemplaza el texto CSV Alumno.alg, que el DTO sigue mostrando como «Maní, Lactosa».
  alergias      AlumnoAlergia[]
  /// Resultado del alumno en cada proceso de promocion de curso aplicado (PromocionDetalle).
  promociones   PromocionDetalle[]
  /// Historial de reinscripcion del alumno.
  reinscripciones ReinscripcionEvento[]
  reservas ReinscripcionReserva[]

  @@index([tutorId])
  @@index([tutorLegalId])
  @@index([seccionId])
}

// ---- Móvil (portal tutor + pase de lista) ----
// Notas de demostración del portal cuando no hay AcadNota.
model MobNota {
  id        String  @id @db.NVarChar(100)
  alumnoId  String  @db.NVarChar(100)
  alumno    Alumno  @relation(fields: [alumnoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  materiaId String  @db.NVarChar(100)
  materia   Materia @relation(fields: [materiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  valor     Float

  @@index([alumnoId])
  @@index([materiaId])
}

/// Monedero virtual del comedor: UNA sola cuenta de saldo por alumno (antes MobWallet + ComCarnet.wallet/limit/spent, dos fuentes). Cada recarga y cada
/// consumo es una fila de MonederoMovimiento; el consumo del dia se calcula con ellas.
model Monedero {
  alumnoId    String @id @db.NVarChar(100)
  alumno      Alumno @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saldo       Float
  /// Limite diario de consumo fijado por el tutor.
  limite      Float
  movimientos MonederoMovimiento[]
}

model MonederoMovimiento {
  id           Int      @id @default(autoincrement())
  alumnoId     String   @db.NVarChar(100)
  monedero     Monedero @relation(fields: [alumnoId], references: [alumnoId], onDelete: NoAction, onUpdate: NoAction)
  /// Recarga | Consumo | Ajuste.
  tipo         String   @db.NVarChar(20)
  /// Con signo: positivo = entra saldo (Recarga), negativo = sale (Consumo).
  monto        Float
  saldoDespues Float
  concepto     String   @default("")
  /// Pago del portal que origino la recarga (NULL = recarga en caja / consumo).
  intencionId  String?  @db.NVarChar(100)
  intencion    MobPagoIntencion? @relation(fields: [intencionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creado       DateTime @default(now())

  @@index([alumnoId, creado])
  @@index([intencionId])
}

model MobAcceso {
  id        String   @id @default(cuid()) @db.NVarChar(100)
  alumnoId  String   @db.NVarChar(100)
  alumno    Alumno   @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hora      String
  resultado String // ok | alert | no
  creado    DateTime @default(now())

  @@index([alumnoId])
}

// ---- Operación: comedor, planes de alimentación, comunicaciones ----
model AliPlan {
  id       String @id @db.NVarChar(100)
  name     String
  modelo   String // sub | wal
  precio   Float?
  freq     String
  dias     String
  mora     Boolean
  recarga  Float?
  limite   Float?
  canal    String
  saldo    String
  estado   String @default("Activo")
  // «Inscritos» = COUNT(ComCarnet.aliPlanId): se calcula, ya no se guarda.
  carnets  ComCarnet[]
  servicios ServicioAlumno[]
  /// Comidas y dietas incluidas (reemplazan las banderas posicionales meals/diets).
  comidas  AliPlanComida[]
  dietas   AliPlanDieta[]
}

model AliMenu {
  orden Int    @id
  dia   String
  plato String
  /// Alergenos del plato (reemplaza el JSON de nombres).
  alergias AliMenuAlergia[]
}

// Carnet de comedor. Convencion UNICA: code = Alumno.code (p. ej. EST-2026-0412). El escaner tambien acepta la forma corta heredada EST-<Alumno.id>.
// Saldo, limite y consumo del dia salen del Monedero del alumno (una sola fuente). Las alergias del carnet salen de Alumno.alergias (AlumnoAlergia).
model ComCarnet {
  code      String @id @db.NVarChar(100)
  alumnoId  String @unique @db.NVarChar(100)
  alumno    Alumno @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Plan de alimentación vigente (NULL = sin plan). `plan` es solo la etiqueta que se muestra en pantalla.
  aliPlanId String? @db.NVarChar(100)
  aliPlan   AliPlan? @relation(fields: [aliPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String
  grado     String
  plan      String
  ok        Boolean
  restr     String
  motivo    String @default("")

  @@index([aliPlanId])
}

model ComLectura {
  id       String   @id @default(cuid()) @db.NVarChar(100)
  t        String
  /// Instantanea del nombre leido (el alumno puede cambiar de nombre o dejar de existir).
  n        String
  alumnoId String?  @db.NVarChar(100)
  alumno   Alumno?  @relation(fields: [alumnoId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  s        String // ok | alert | no
  creado   DateTime @default(now())

  @@index([alumnoId])
}

model CmnMensaje {
  id     Int    @id @default(autoincrement())
  batch  String @default("")
  t      String
  /// Instantanea del nombre del tutor destinatario.
  to     String
  tutorId String? @db.NVarChar(100)
  tutor   Tutor?  @relation(fields: [tutorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  canal  String
  asunto String
  estado String // En cola | Enviando | Entregado | Fallido | Canal no configurado
  /// Instantanea del usuario emisor (p. ej. usr_sistema para los avisos automaticos).
  by     String
  /// Usuario emisor (NULL = sistema). NoAction: SQL Server rechaza dos caminos de cascada User->Tutor->CmnMensaje y User->CmnMensaje.
  userId String? @db.NVarChar(100)
  user   User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cuerpo   String @default("") @db.NVarChar(Max)
  destino  String @default("") // dirección real (correo) resuelta al encolar
  error    String @default("") @db.NVarChar(Max) // último error real del proveedor
  intentos Int    @default(0)

  @@index([tutorId])
  @@index([userId])
}

// Intención de pago del portal del tutor cuando no hay pasarela activa: queda pendiente hasta que el cajero verifica el pago.
model MobPagoIntencion {
  id          String    @id @default(cuid()) @db.NVarChar(100)
  alumnoId    String    @db.NVarChar(100)
  alumno      Alumno    @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tutorId     String    @db.NVarChar(100)
  tutor       Tutor     @relation(fields: [tutorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipo        String // cargos | recarga
  monto       Float
  /// Cargos que cubre (tipo 'cargos'): reemplaza el JSON `detalle`.
  cargos      MobPagoIntencionCargo[]
  estado      String    @default("pendiente") @db.NVarChar(100) // pendiente | confirmada | rechazada
  creado      DateTime  @default(now())
  resuelto    DateTime?
  /// Cuenta que la resolvio (User); NULL mientras esta pendiente.
  resueltoPorId String?  @db.NVarChar(100)
  resueltoPor   User?    @relation(fields: [resueltoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Recargas del monedero originadas por esta intencion.
  recargas    MonederoMovimiento[]
  nota        String    @default("") @db.NVarChar(Max)
  /// Recibo que la salda (NULL = sin recibo).
  reciboId    String?   @db.NVarChar(100)
  recibo      FinRecibo? @relation(fields: [reciboId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([estado])
  @@index([alumnoId])
  @@index([tutorId])
  @@index([reciboId])
  @@index([resueltoPorId])
}

/// Cargos (FinCobroItem) que incluye una intencion de pago del portal (reemplaza el JSON de ids).
model MobPagoIntencionCargo {
  intencionId String           @db.NVarChar(100)
  intencion   MobPagoIntencion @relation(fields: [intencionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cobroItemId String           @db.NVarChar(100)
  cobroItem   FinCobroItem     @relation(fields: [cobroItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([intencionId, cobroItemId])
  @@index([cobroItemId])
}

// ---------- Finanzas (POS/Cobros, Kiosko, Inventario, Planes de Pago, Becas) ----------
model FinCobroItem {
  id       String  @id @db.NVarChar(100)
  /// Alumno al que se le cobra (Alumno.id real; NO el codigo ni alias).
  alumnoId String  @db.NVarChar(100)
  alumno   Alumno  @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Tutor responsable de pagar este cargo (NULL = el del alumno).
  tutorId  String? @db.NVarChar(100)
  tutor    Tutor?  @relation(fields: [tutorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Servicio recurrente/unico que origino el cargo (NULL = colegiatura, recargo u otro cargo sin servicio).
  servicioId String? @db.NVarChar(100)
  servicio   ServicioAlumno? @relation(fields: [servicioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Ciclo lectivo al que pertenece el cargo (por su concepto / fecha de vencimiento). La cartera pendiente del ciclo ACTIVO es la unica exigible en la app.
  cicloId  String  @db.NVarChar(100)
  ciclo    Ciclo   @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  con      String
  al       String
  vence    String
  monto    Float
  est      String
  tipo     String
  paid     Boolean @default(false)
  abono    Boolean @default(false)
  orden    Int     @default(0)
  /// Nota de debito que origino este cargo (intereses por mora, recargo, ajuste...). NULL = cargo normal. Se cobra como cualquier otro y su recibo la referencia.
  notaDebitoId String? @db.NVarChar(100)
  notaDebito   NotaFiscal? @relation("NotaDebitoCargos", fields: [notaDebitoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Lineas de recibo que cobraron este cargo y pagos del portal que lo incluyen.
  lineasRecibo FinReciboItem[]
  intenciones  MobPagoIntencionCargo[]
  /// Lineas de notas de credito que reabrieron / ajustaron este cargo.
  notaLineas   NotaFiscalLinea[]

  @@index([alumnoId, paid])
  @@index([tutorId])
  @@index([servicioId])
  @@index([cicloId, paid])
  @@index([notaDebitoId])
}

model FinRecibo {
  id        String  @id @db.NVarChar(100)
  ncf       String  @unique @db.NVarChar(100)
  /// Comprobante fiscal (Fase fiscal): tipo (B01, B02... E31...) y secuencia autorizada de la que salio el NCF. Los DEFAULT apuntan al tipo B02 y a la secuencia
  /// "historica" B02 solo para filas creadas por seeds/importadores sin pasar por lib/fiscal.asignarNcf; la API de cobros SIEMPRE los fija explicitamente.
  tipoComprobanteId   String @default("B02") @db.NVarChar(100)
  tipoComprobante     TipoComprobante @relation(fields: [tipoComprobanteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  secuenciaFiscalId   String @default("SF-HIST-B02-FISICA") @db.NVarChar(100)
  secuenciaFiscal     SecuenciaFiscal @relation(fields: [secuenciaFiscalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// FISICA (NCF serie B) | ELECTRONICA (e-NCF serie E).
  modalidad           String @default("FISICA")
  /// Datos fiscales del comprador (obligatorios en credito fiscal / gubernamental / regimen especial). Instantanea: no cambia si el tutor se edita.
  clienteRnc          String?
  clienteNombre       String?
  /// Numero / certificacion del regimen especial (opcional, A VALIDAR).
  regimenEspecial     String?
  /// Envio a la DGII del e-NCF: NoAplica | PendienteEnvio | Aceptado | Rechazado | Contingencia. Un e-NCF electrónico queda en PendienteEnvio hasta que se integre el envío (fase final, docs/integracion-ecf.md).
  estadoDgii          String @default("NoAplica")
  /// Instantanea del nombre del tutor en el comprobante emitido ("Consumidor final" si no hay tutor).
  tutor     String
  tutorId   String? @db.NVarChar(100)
  titular   Tutor?  @relation(fields: [tutorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Caja donde se cobro (NULL = el cajero no tenia caja asignada) y usuario que cobro.
  cajaId    String? @db.NVarChar(100)
  caja      Caja?   @relation(fields: [cajaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Ciclo lectivo del recibo (el activo al emitirlo; los historicos, el que contiene su fecha de emision).
  cicloId   String  @db.NVarChar(100)
  ciclo     Ciclo   @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Metodo de pago cuando el recibo se cobro con UN solo medio (NULL = pago mixto o recibo historico sin medio). El detalle por medio es FinReciboPago
  /// (una fila por medio con FK a MetodoPago); esta columna es su copia de acceso rapido para el pago unico.
  metodoPagoId String? @db.NVarChar(100)
  metodoPago   MetodoPago? @relation(fields: [metodoPagoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cajeroId  String? @db.NVarChar(100)
  cajero    User?   @relation(fields: [cajeroId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hora      String
  monto     Float
  est       String  @default("Activo")
  abono     Boolean @default(false)
  saldo     Float   @default(0)
  nc        String?
  change    Float   @default(0)
  createdAt DateTime @default(now())
  /// Lineas del recibo (concepto + monto; cobroItemId = cargo cobrado, NULL en lineas historicas sin cargo en cartera) y pagos por medio.
  lineas      FinReciboItem[]
  pagos       FinReciboPago[]
  servicios   ServicioAlumno[]
  intenciones MobPagoIntencion[]
  /// Notas de credito / debito que modifican este comprobante.
  notas       NotaFiscal[]

  @@index([tutorId])
  @@index([cicloId])
  @@index([cajeroId])
  @@index([cajaId])
  @@index([metodoPagoId])
  @@index([createdAt])
  @@index([tipoComprobanteId])
  @@index([secuenciaFiscalId])
}

/// Linea de un recibo. `cobroItemId` = cargo de cartera que salda (NULL permitido: lineas historicas anteriores al registro del vinculo o cobros sin cargo).
model FinReciboItem {
  id          Int           @id @default(autoincrement())
  reciboId    String        @db.NVarChar(100)
  recibo      FinRecibo     @relation(fields: [reciboId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orden       Int
  concepto    String
  monto       Float
  cobroItemId String?       @db.NVarChar(100)
  cobroItem   FinCobroItem? @relation(fields: [cobroItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Descuento aplicado a ESTA linea al cobrar (RD$; `monto` sigue siendo el bruto del cargo) y su motivo (p. ej. «Pronto pago 5 %», «Exoneración de mora»). 0 / NULL = sin descuento.
  descuento       Float   @default(0)
  descuentoMotivo String? @db.NVarChar(200)
  /// Beca / Plan Hermano ya INCLUIDA en `monto` (que sigue siendo lo cobrado): monto real (bruto del plan), descuento por beca (RD$) y motivo («Plan Hermano 10 %»). NULL / 0 = linea sin beca (recibos anteriores).
  montoBruto      Float?
  descuentoBeca   Float   @default(0)
  becaMotivo      String? @db.NVarChar(200)
  notaLineas  NotaFiscalLinea[]

  @@unique([reciboId, orden])
  @@index([cobroItemId])
}

/// Pago de un recibo por un medio (un recibo mixto tiene varias filas). `referencia` = autorizacion / numero de transferencia o cheque ('' si el medio no la pide).
model FinReciboPago {
  id           Int        @id @default(autoincrement())
  reciboId     String     @db.NVarChar(100)
  recibo       FinRecibo  @relation(fields: [reciboId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orden        Int
  metodoPagoId String     @db.NVarChar(100)
  metodoPago   MetodoPago @relation(fields: [metodoPagoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  monto        Float
  referencia   String     @default("")

  @@unique([reciboId, orden])
  @@index([metodoPagoId])
}

/// Catalogo FIJO de tipos de comprobante fiscal de la DGII (seed idempotente en lib/fiscal.asegurarCatalogoFiscal). id = codigo (B01, E31...).
/// Nombres y alcance segun el mejor conocimiento del equipo; lo dudoso lleva «A VALIDAR» en `nota` (validar con contador / DGII).
model TipoComprobante {
  id        String  @id @db.NVarChar(100)
  codigo    String  @unique @db.NVarChar(100)
  nombre    String
  /// Uso: Ventas | Notas | Compras | Gastos | Ingresos | Exportaciones | Exterior
  uso       String
  /// FISICA | ELECTRONICA
  modalidad String
  /// Digitos del tipo dentro del numero: B01 -> 01, E31 -> 31.
  tipoNum   String
  /// Tipo LOGICO que usa Cobros (CREDITO_FISCAL | CONSUMO | GUBERNAMENTAL | REGIMEN_ESPECIAL | NOTA_DEBITO | NOTA_CREDITO); NULL = no se emite desde Cobros.
  logico    String?
  /// Exige RNC/cedula y razon social del comprador.
  requiereRnc Boolean @default(false)
  nota      String  @default("")
  orden     Int
  secuencias SecuenciaFiscal[]
  recibos    FinRecibo[]
  notas      NotaFiscal[]

  @@index([logico, modalidad])
}

/// Autorizacion de secuencia (rango) de la DGII para un tipo de comprobante. `actual` = ULTIMO numero usado (desde-1 si no se uso ninguno). El incremento es atomico
/// (lib/fiscal.asignarNcf). Los rangos de un mismo tipo+modalidad no se solapan (lo valida la API; las filas `historica` quedan fuera de esa regla: solo documentan lo emitido antes).
/// Numeros como Float: enteros exactos hasta 2^53 (un e-NCF llega a 10 digitos, mas que un Int de 32 bits).
model SecuenciaFiscal {
  id        String  @id @db.NVarChar(100)
  tipoComprobanteId String @db.NVarChar(100)
  tipoComprobante   TipoComprobante @relation(fields: [tipoComprobanteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// FISICA | ELECTRONICA
  modalidad String
  /// 'B' | 'E'
  prefijo   String
  serie     String  @default("")
  desde     Float
  hasta     Float
  actual    Float
  /// Vencimiento de la autorizacion DGII, 'YYYY-MM-DD' (NULL = sin vencimiento registrado).
  vence     String?
  umbralPct Int     @default(10)
  /// Activa | Agotada | Vencida | Inactiva
  estado    String  @default("Activa")
  autorizacion String @default("")
  /// Secuencia sintetica creada por la migracion para lo emitido ANTES del modulo fiscal (nunca se consume).
  historica Boolean @default(false)
  creadaPor String  @default("")
  createdAt DateTime @default(now())
  recibos   FinRecibo[]
  notas     NotaFiscal[]

  @@unique([tipoComprobanteId, modalidad, historica, desde])
  @@index([tipoComprobanteId, modalidad, estado])
}

/// Catalogo tipado de MOTIVOS de nota de credito / debito. `codigo` 01..05 = codigos de modificacion de la DGII (A VALIDAR); OPxx = motivos operativos del colegio
/// (reportan `codigoDgii`). Se siembra de forma idempotente (lib/notas.asegurarMotivosNota). Se desactivan (estado), no se borran.
model MotivoNota {
  id         String @id @db.NVarChar(100)
  codigo     String @unique @db.NVarChar(100)
  nombre     String
  /// DGII | Operativo
  origen     String
  /// CREDITO | DEBITO | AMBAS
  aplica     String
  /// Codigo de modificacion de la DGII (01..05) que se informa para este motivo (los operativos mapean al mas cercano; A VALIDAR).
  codigoDgii String
  orden      Int
  estado     String @default("Activo")
  notas      NotaFiscal[]
}

/// NOTA DE CREDITO (B04 / E34) o NOTA DE DEBITO (B03 / E33) emitida sobre un comprobante: un recibo (FinRecibo) o una venta rapida del kiosko (FinVenta); exactamente UNO de los dos
/// (CHECK CK_NotaFiscal_documento). La modalidad (fisica/electronica) es la del NCF modificado. El NCF sale de SecuenciaFiscal dentro de la misma transaccion (lib/fiscal.asignarNcf).
/// id estable NC-0001 / ND-0001. `idempotencyKey` UNIQUE: reenviar la misma peticion no crea otra nota. Una nota es inmutable (solo `estado` Emitida).
model NotaFiscal {
  id         String @id @db.NVarChar(100)
  /// CREDITO | DEBITO
  clase      String
  tipoComprobanteId String @db.NVarChar(100)
  tipoComprobante   TipoComprobante @relation(fields: [tipoComprobanteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  secuenciaFiscalId String @db.NVarChar(100)
  secuenciaFiscal   SecuenciaFiscal @relation(fields: [secuenciaFiscalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ncf        String @unique @db.NVarChar(100)
  /// FISICA | ELECTRONICA (la del comprobante modificado).
  modalidad  String @default("FISICA")
  /// NoAplica | PendienteEnvio | Aceptado | Rechazado | Contingencia. Un e-NCF electrónico queda en PendienteEnvio hasta que se integre el envío (fase final, docs/integracion-ecf.md).
  estadoDgii String @default("NoAplica")
  /// Documento afectado: un recibo o una venta del kiosko (exactamente uno).
  reciboId   String? @db.NVarChar(100)
  recibo     FinRecibo? @relation(fields: [reciboId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ventaId    String? @db.NVarChar(100)
  venta      FinVenta? @relation(fields: [ventaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Copia del NCF / e-NCF modificado (instantanea).
  ncfModificado String @db.NVarChar(100)
  tutorId    String? @db.NVarChar(100)
  tutor      Tutor?  @relation(fields: [tutorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Instantanea del nombre y RNC/cedula del cliente en el comprobante.
  clienteNombre String?
  clienteRnc    String?
  cicloId    String @db.NVarChar(100)
  ciclo      Ciclo  @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  motivoId   String @db.NVarChar(100)
  motivo     MotivoNota @relation(fields: [motivoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  motivoTexto String @default("")
  monto      Float
  /// Emitida fuera del plazo configurado (exigio motivo escrito).
  fueraDePlazo Boolean @default(false)
  cajeroId   String? @db.NVarChar(100)
  cajero     User?   @relation(fields: [cajeroId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cajaId     String? @db.NVarChar(100)
  caja       Caja?   @relation(fields: [cajaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hora       String
  createdAt  DateTime @default(now())
  estado     String @default("Emitida")
  idempotencyKey String @unique @db.NVarChar(200)
  lineas     NotaFiscalLinea[]
  reembolsos NotaFiscalReembolso[]
  /// Cargos nuevos que creo una nota de debito.
  cargos     FinCobroItem[] @relation("NotaDebitoCargos")

  @@index([reciboId])
  @@index([ventaId])
  @@index([tutorId])
  @@index([cicloId, createdAt])
  @@index([createdAt])
  @@index([cajeroId, createdAt])
  @@index([cajaId])
  @@index([motivoId])
  @@index([tipoComprobanteId])
  @@index([secuenciaFiscalId])
}

/// Linea de una nota. Credito: reciboItemId (+ cobroItemId del cargo) o ventaItemId (+ productoId, cantidad devuelta). Debito: el cargo creado (cobroItemId, efecto NuevoCargo).
/// efecto: ReabreCargo (el cargo vuelve a la deuda) | Devolucion (producto devuelto: repone inventario) | Ajuste (credito sin reabrir el cargo) | NuevoCargo (debito).
model NotaFiscalLinea {
  id         Int    @id @default(autoincrement())
  notaId     String @db.NVarChar(100)
  nota       NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orden      Int
  reciboItemId Int?
  reciboItem   FinReciboItem? @relation(fields: [reciboItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cobroItemId  String? @db.NVarChar(100)
  cobroItem    FinCobroItem? @relation(fields: [cobroItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ventaItemId  Int?
  ventaItem    FinVentaItem? @relation(fields: [ventaItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productoId   String? @db.NVarChar(100)
  producto     FinProducto? @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cantidad   Int    @default(0)
  concepto   String
  monto      Float
  /// ReabreCargo | Devolucion | Ajuste | NuevoCargo
  efecto     String

  @@unique([notaId, orden])
  @@index([reciboItemId])
  @@index([cobroItemId])
  @@index([ventaItemId])
  @@index([productoId])
}

/// Devolucion de dinero al cliente por medio de pago (una fila por medio). El total reembolsado de una nota de credito es igual a su monto (ver docs/fiscal-ncf.md).
model NotaFiscalReembolso {
  id           Int    @id @default(autoincrement())
  notaId       String @db.NVarChar(100)
  nota         NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orden        Int
  metodoPagoId String @db.NVarChar(100)
  metodoPago   MetodoPago @relation(fields: [metodoPagoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  monto        Float
  referencia   String @default("")

  @@unique([notaId, orden])
  @@index([metodoPagoId])
}

model FinCounter {
  key   String @id @db.NVarChar(100)
  value Int
}

/// Plan de pago = plantilla reutilizable en todos los ciclos (el ciclo lo fija Contrato). `data` = parametros escalares del formulario (cuotas, frecuencia, mora...);
/// el importe por tanda (antes `tm` dentro del JSON) es FinPlanTanda.
model FinPlan {
  id      String @id @db.NVarChar(100)
  name    String
  estado  String @default("Activo")
  data    String @db.NVarChar(Max)
  // «Alumnos» de un plan = COUNT(Contrato.planId) del ciclo: se calcula, ya no se guarda.
  contratos     Contrato[]
  inscripciones PersInscripcion[]
  tandas        FinPlanTanda[]
}

/// Importe anual del plan por tanda (solo si el plan es `porTanda`).
model FinPlanTanda {
  planId  String  @db.NVarChar(100)
  plan    FinPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tandaId String  @db.NVarChar(100)
  tanda   Tanda   @relation(fields: [tandaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  monto   Float

  @@id([planId, tandaId])
  @@index([tandaId])
}

model FinBeca {
  id        String @id @db.NVarChar(100)
  /// Ciclo lectivo de la beca (antes el texto `periodo` «2026–2027»).
  cicloId   String @db.NVarChar(100)
  ciclo     Ciclo  @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alumnoId  String @db.NVarChar(100)
  alumno    Alumno @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Instantanea del nombre completo del beneficiario.
  est       String
  grado     String
  /// Tipo de beca (FK a TipoBeca).
  tipoBecaId String @db.NVarChar(100)
  tipoBeca   TipoBeca @relation(fields: [tipoBecaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Regla: modo 'pct' (valor = porcentaje, p. ej. 50) o 'monto' (valor = RD$). El DTO la muestra como «50%» o «RD$ 2,000.00».
  modo      String @db.NVarChar(10)
  valor     Float
  /// Conceptos que cubre (reemplaza el texto «Colegiatura · Inscripción»).
  conceptos FinBecaConcepto[]
  exp       String
  estado    String
  aprob     String
  createdAt DateTime @default(now())

  @@index([alumnoId])
  @@index([tipoBecaId])
  @@index([cicloId])
}

model FinProducto {
  id    String  @id @db.NVarChar(100)
  code  String  @unique @db.NVarChar(100)
  name  String
  /// Categoria del producto (FK a CategoriaProducto; el DTO la muestra como texto en `cat`).
  categoriaId String @db.NVarChar(100)
  categoria   CategoriaProducto @relation(fields: [categoriaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  price Float
  tax   Boolean @default(false)
  stock Int?
  icon  String
  movimientos FinMovimiento[]
  lineas      FinVentaItem[]
  servicios   ServicioAlumno[]
  notaLineas  NotaFiscalLinea[]

  @@index([categoriaId])
}

model FinMovimiento {
  id         Int      @id @default(autoincrement())
  t          String
  tipo       String
  productoId String   @db.NVarChar(100)
  producto   FinProducto @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Instantanea del nombre del producto.
  name       String
  q          String
  /// Referencia visible: VTA-nnnn (salida) o ENT-nnnn (entrada).
  ref        String
  /// Venta que origino la salida (NULL en entradas o ventas anteriores al registro de lineas).
  ventaId    String?  @db.NVarChar(100)
  venta      FinVenta? @relation(fields: [ventaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt  DateTime @default(now())

  @@index([productoId])
  @@index([ventaId])
}

model FinVenta {
  id        String   @id @db.NVarChar(100)
  ncf       String
  total     Float
  /// Instantanea del nombre del medio de pago; la referencia real es metodoPagoId.
  metodo    String
  metodoPagoId String @db.NVarChar(100)
  metodoPago   MetodoPago @relation(fields: [metodoPagoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doc       String
  /// Cajero que hizo la venta rapida (NULL = ventas anteriores a este campo); entra al cuadre de su turno (GET /cobros/turno).
  cajeroId  String? @db.NVarChar(100)
  cajero    User?   @relation(fields: [cajeroId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  movimientos FinMovimiento[]
  lineas      FinVentaItem[]
  /// Notas de credito que devuelven productos de esta venta.
  notas       NotaFiscal[]

  @@index([metodoPagoId])
  @@index([cajeroId, createdAt])
}

// Lineas de una venta del kiosko (producto, cantidad y precio al momento de vender).
model FinVentaItem {
  id         Int         @id @default(autoincrement())
  ventaId    String      @db.NVarChar(100)
  venta      FinVenta    @relation(fields: [ventaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productoId String      @db.NVarChar(100)
  producto   FinProducto @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nombre     String
  cantidad   Int
  precio     Float
  tax        Boolean     @default(false)
  notaLineas NotaFiscalLinea[]

  @@index([ventaId])
  @@index([productoId])
}

// ---- Sistema (licencia, configuración, auditoría) ----
model SisAudit {
  id       String @id @default(cuid()) @db.NVarChar(100)
  t        String @db.NVarChar(100) // 'YYYY-MM-DD HH:mm:ss' UTC
  usr      String
  accion   String // Insert | Update | Delete
  tabla    String
  registro String
  prev     String @default("") @db.NVarChar(Max)
  next     String @default("") @db.NVarChar(Max)
  ip       String @default("")

  @@index([t])
}

// Folio de verificación de documentos emitidos (boletines): folio + hash SHA-256 del contenido. NO es firma digital.
model DocFolio {
  folio      String   @id @db.NVarChar(100)
  tipo       String
  hash       String
  detalle    String   @default("") @db.NVarChar(Max)
  emitidoPor String   @default("")
  createdAt  DateTime @default(now())
}

// Clave/valor JSON: licencia, perfil, assets, ncf, ecf, ciclos, access
model SisConfig {
  clave String @id @db.NVarChar(100)
  valor String @db.NVarChar(Max)
}

// ---------- CICLO LECTIVO (Fase 2C) ----------
/// Ciclo lectivo (`2026–2027`). UN solo Activo (indice unico filtrado UX_Ciclo_activo). Las fechas son 'YYYY-MM-DD' (comparables como texto).
/// Un ciclo Cerrado es de SOLO LECTURA para la aplicacion. No se borra con datos (todas las FK son NoAction salvo sus periodos).
model Ciclo {
  id          String @id @db.NVarChar(100)
  nombre      String @unique @db.NVarChar(100)
  fechaInicio String @db.NVarChar(10)
  fechaFin    String @db.NVarChar(10)
  /// Planificado | Activo | Cerrado
  estado      String @default("Planificado") @db.NVarChar(20)
  periodos      PeriodoAcademico[]
  matriculas    Matricula[]
  contratos     Contrato[]
  becas         FinBeca[]
  inscripciones PersInscripcion[]
  cobros        FinCobroItem[]
  recibos       FinRecibo[]
  notas         NotaFiscal[]
  asignaciones  AcadAsignacion[]
  horarios      AcadHorario[]
  /// Cierre contable/administrativo del ciclo (0..1) y procesos de promocion de curso que lo usan como origen / destino (docs/cierre-y-promocion.md).
  cierre            CierreCiclo?
  promocionesOrigen PromocionCiclo[] @relation("PromocionOrigen")
  promocionesDestino PromocionCiclo[] @relation("PromocionDestino")
  /// Historial de reinscripcion (reservas, confirmaciones, liberaciones) de este ciclo destino y su fecha limite (0..1).
  reinscripciones ReinscripcionEvento[]
  reinscripcionCfg CicloReinscripcion?
  reservas ReinscripcionReserva[]
}

/// Periodo de calificacion dentro de un ciclo (por defecto 4: Ago–Oct, Nov–Ene, Feb–Abr, May–Jul). `orden` 1..4 es la clave '1'..'4' que usa la API.
model PeriodoAcademico {
  id          String @id @db.NVarChar(100)
  cicloId     String @db.NVarChar(100)
  ciclo       Ciclo  @relation(fields: [cicloId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orden       Int
  nombre      String @db.NVarChar(100)
  fechaInicio String @db.NVarChar(10)
  fechaFin    String @db.NVarChar(10)
  notas       AcadNota[]
  asistencias AsistenciaResumen[]

  @@unique([cicloId, orden])
}

/// Matricula = historial real del alumno: en que seccion estuvo en cada ciclo. FUENTE de verdad; Alumno.seccionId es la matricula del ciclo activo.
/// Estado: Activo | Retirado | Promovido | Repitente | Graduado.
model Matricula {
  id           String  @id @db.NVarChar(100)
  alumnoId     String  @db.NVarChar(100)
  alumno       Alumno  @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cicloId      String  @db.NVarChar(100)
  ciclo        Ciclo   @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seccionId    String  @db.NVarChar(100)
  seccion      Seccion @relation(fields: [seccionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estado       String  @default("Activo") @db.NVarChar(20)
  fechaIngreso String  @db.NVarChar(10)
  fechaRetiro  String? @db.NVarChar(10)
  asistencias  AsistenciaResumen[]
  /// Marca de que es una RESERVA por reinscripcion (la promocion no la trata como copia automatica). Tabla aparte: no cambia las columnas de Matricula.
  reinscripcion ReinscripcionReserva?

  @@unique([alumnoId, cicloId])
  @@index([cicloId])
  @@index([seccionId])
}

/// Resumen de asistencia por matricula y periodo (ciclos cerrados: el detalle diario AcadAsistencia no se conserva por alumno; el del ciclo activo vive en AcadAsistencia por fecha).
model AsistenciaResumen {
  id          Int              @id @default(autoincrement())
  matriculaId String           @db.NVarChar(100)
  matricula   Matricula        @relation(fields: [matriculaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periodoId   String           @db.NVarChar(100)
  periodo     PeriodoAcademico @relation(fields: [periodoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  diasLectivos Int
  presentes   Int
  tardanzas   Int
  ausenciasJustificadas   Int
  ausenciasInjustificadas Int

  @@unique([matriculaId, periodoId])
  @@index([periodoId])
}

/// Vinculo tutor-alumno con rol y vigencia (FUENTE de verdad; Alumno.tutorId / tutorLegalId son su copia vigente). Rol: Financiero | Legal | Academico.
/// Indices unicos filtrados (lib/db-indices): un solo Financiero y un solo Legal VIGENTES por alumno (hasta IS NULL).
model TutorAlumno {
  id       Int    @id @default(autoincrement())
  alumnoId String @db.NVarChar(100)
  alumno   Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tutorId  String @db.NVarChar(100)
  tutor    Tutor  @relation(fields: [tutorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rol      String @db.NVarChar(20)
  /// Vigencia 'YYYY-MM-DD': desde (inclusive) y hasta (NULL = vigente).
  desde    String @db.NVarChar(10)
  hasta    String? @db.NVarChar(10)

  @@unique([alumnoId, tutorId, rol, desde])
  @@index([tutorId])
}

// ---------- Estructura académica (Fase 2A): catálogos TIPADOS. Conservan los ids de texto que tenían en Catalogo (g6, s1, m1, d1, a1, t1...). ----------
// Los catálogos se DESACTIVAN (estado), no se borran: con dependientes la FK NoAction lo impide y la API responde 409.

/// Nivel educativo (Inicial / Primaria / Secundaria). Tabla de referencia fija: se siembra siempre (seed.ts > asegurarNiveles).
model Nivel {
  id     String  @id @db.NVarChar(100)
  nombre String  @unique @db.NVarChar(100)
  orden  Int     @unique
  grados Grado[]
}

/// Grado dentro de un nivel. El nombre ('1ro') se repite entre niveles: la llave es el id o (nivel, nombre).
model Grado {
  id      String @id @db.NVarChar(100)
  nivelId String @db.NVarChar(100)
  nivel   Nivel  @relation(fields: [nivelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nombre  String @db.NVarChar(100)
  /// Orden de promoción (único): la promoción de curso (lib/promocion.ts) pasa al aprobado al grado con el orden siguiente; el último por orden egresa.
  orden   Int
  estado  String @default("Activo")
  secciones Seccion[]
  materias  MateriaGrado[]
  extras    AcadExtraGrado[]

  @@unique([nivelId, nombre])
  @@unique([orden])
}

model Tanda {
  id     String @id @db.NVarChar(100)
  nombre String @unique @db.NVarChar(100)
  /// Hora de entrada / salida 'HH:MM'.
  ini    String @db.NVarChar(10)
  fin    String @db.NVarChar(10)
  estado String @default("Activo")
  secciones Seccion[]
  planes    FinPlanTanda[]
}

model Aula {
  id       String @id @db.NVarChar(100)
  nombre   String @unique @db.NVarChar(100)
  tipo     String @db.NVarChar(100) // Aula | Laboratorio | Cancha | Salón especial
  edificio String @default("") @db.NVarChar(200)
  pupitres Int
  estado   String @default("Activo")
  secciones     Seccion[]
  asignaciones  AsignacionAula[]
  elegidaEn     AcadAsignacion[]
  extras        AcadExtra[]
}

/// Sección = grado + letra + tanda. Los inscritos se CALCULAN (COUNT de Alumno no Retirado); `cap` es la capacidad máxima.
model Seccion {
  id         String  @id @db.NVarChar(100)
  gradoId    String  @db.NVarChar(100)
  grado      Grado   @relation(fields: [gradoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  letra      String  @db.NVarChar(20)
  tandaId    String  @db.NVarChar(100)
  tanda      Tanda   @relation(fields: [tandaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aulaBaseId String? @db.NVarChar(100)
  aulaBase   Aula?   @relation(fields: [aulaBaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cap        Int
  estado     String  @default("Activo")
  alumnos      Alumno[]
  rosters      AcadRoster[]
  asignaciones AcadAsignacion[]
  horarios     AcadHorario[]
  plan         SeccionMateria[]
  docentes     DocenteSeccion[]
  matriculas   Matricula[]

  @@unique([gradoId, letra, tandaId])
  @@index([tandaId])
  @@index([aulaBaseId])
}

/// Rúbrica de evaluación: escala, nota mínima y criterios con peso (RubricaCriterio). Cada materia usa a lo sumo UNA (Materia.rubricaId).
model Rubrica {
  id        String @id @db.NVarChar(100)
  nombre    String @unique @db.NVarChar(200)
  escala    String @db.NVarChar(200)
  minimo    Int
  estado    String @default("Activo")
  criterios RubricaCriterio[]
  materias  Materia[]
}

/// Competencia / criterio de una rúbrica. `clave` = C1..C4 (competencias) o EX (examen) con la que se capturan las notas (AcadNota.c1..c4/ex).
model RubricaCriterio {
  rubricaId String  @db.NVarChar(100)
  rubrica   Rubrica @relation(fields: [rubricaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orden     Int
  nombre    String  @db.NVarChar(200)
  peso      Float
  clave     String? @db.NVarChar(10)

  @@id([rubricaId, orden])
}

model Materia {
  id        String   @id @db.NVarChar(100)
  codigo    String   @unique @db.NVarChar(100)
  nombre    String   @db.NVarChar(200)
  /// Horas semanales por defecto (el plan de cada sección las copia en SeccionMateria.horas).
  horas     Int
  rubricaId String?  @db.NVarChar(100)
  rubrica   Rubrica? @relation(fields: [rubricaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estado    String   @default("Activo")
  grados       MateriaGrado[]
  docentes     DocenteMateria[]
  plan         SeccionMateria[]
  asignaciones AcadAsignacion[]
  horarios     AcadHorario[]
  notas        AcadNota[]
  notasMov     MobNota[]

  @@index([rubricaId])
}

/// Grados donde se imparte una materia (N:M).
model MateriaGrado {
  materiaId String  @db.NVarChar(100)
  materia   Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gradoId   String  @db.NVarChar(100)
  grado     Grado   @relation(fields: [gradoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([materiaId, gradoId])
  @@index([gradoId])
}

/// Plan de estudios de una sección: materias que cursa y sus horas semanales.
model SeccionMateria {
  seccionId String  @db.NVarChar(100)
  seccion   Seccion @relation(fields: [seccionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  materiaId String  @db.NVarChar(100)
  materia   Materia @relation(fields: [materiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  horas     Int

  @@id([seccionId, materiaId])
  @@index([materiaId])
}

/// Docente. `userId` = cuenta de login (opcional; unica entre docentes por indice filtrado UX_Docente_userId). `usuario` = usuario PROPUESTO
/// mientras aun no tiene cuenta (al crear el acceso se enlaza userId y deja de usarse).
model Docente {
  id      String  @id @db.NVarChar(100)
  nombre  String
  cedula  String  @unique @db.NVarChar(100)
  esp     String  @default("")
  email   String  @default("")
  tel     String  @default("")
  usuario String? @db.NVarChar(100)
  rol     String  @default("Docente") @db.NVarChar(100)
  userId  String? @db.NVarChar(100)
  user    User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estado  String  @default("Activo")
  materias     DocenteMateria[]
  secciones    DocenteSeccion[]
  asignaciones AcadAsignacion[]
  extras       AcadExtra[]

  @@index([userId])
}

/// Empleado / personal administrativo (antes Catalogo 'staff'). Misma relación con User que Docente.
model Empleado {
  id      String  @id @db.NVarChar(100)
  nombre  String
  cargo   String  @default("")
  usuario String? @db.NVarChar(100)
  rol     String  @default("Cajero") @db.NVarChar(100)
  userId  String? @db.NVarChar(100)
  user    User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Caja asignada (NULL = sin caja).
  cajaId  String? @db.NVarChar(100)
  caja    Caja?   @relation(fields: [cajaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tel     String  @default("")
  email   String  @default("")
  estado  String  @default("Activo")

  @@index([userId])
  @@index([cajaId])
}

/// Materias que un docente puede impartir (N:M).
model DocenteMateria {
  docenteId String  @db.NVarChar(100)
  docente   Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  materiaId String  @db.NVarChar(100)
  materia   Materia @relation(fields: [materiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([docenteId, materiaId])
  @@index([materiaId])
}

/// Secciones asignadas al docente en su perfil. (docente x materias) x (docente x secciones) se materializa en AcadAsignacion (heredada = true).
model DocenteSeccion {
  docenteId String  @db.NVarChar(100)
  docente   Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seccionId String  @db.NVarChar(100)
  seccion   Seccion @relation(fields: [seccionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([docenteId, seccionId])
  @@index([seccionId])
}

// ---------- Académico (Acad*) ----------
// Nómina de una sección (mock del prototipo: STU_ATT).
model AcadRoster {
  id          String           @id @db.NVarChar(100)
  // Sección de la nómina; solo manda para nómina sin Alumno enlazado (la de un Alumno sale de su Alumno.seccionId).
  seccionId   String           @db.NVarChar(100)
  seccion     Seccion          @relation(fields: [seccionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orden       Int
  nombre      String
  // Vínculo con Alumno cuando la demo los trata como el mismo alumno (p. ej. Juan 0412). Nulo = solo figura en la nómina del prototipo.
  alumnoId    String?          @db.NVarChar(100)
  alumno      Alumno?          @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notas       AcadNota[]
  asistencias AcadAsistencia[]

  @@index([seccionId])
  @@index([alumnoId])
}

// Las notas son historial academico con valor propio: NoAction (no se borran en cascada con la nomina).
model AcadNota {
  id        String     @id @default(cuid()) @db.NVarChar(100)
  rosterId  String     @db.NVarChar(100)
  roster    AcadRoster @relation(fields: [rosterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  materiaId String     @db.NVarChar(100)
  materia   Materia    @relation(fields: [materiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Periodo academico (hijo de un Ciclo): de el sale el ciclo de la nota.
  periodoId String     @db.NVarChar(100)
  periodo   PeriodoAcademico @relation(fields: [periodoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  c1        Float?
  c2        Float?
  c3        Float?
  c4        Float?
  ex        Float?

  @@unique([rosterId, materiaId, periodoId])
  @@index([materiaId])
  @@index([periodoId])
}

model AcadAsistencia {
  id        String     @id @default(cuid()) @db.NVarChar(100)
  rosterId  String     @db.NVarChar(100)
  roster    AcadRoster @relation(fields: [rosterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fecha     String @db.NVarChar(100)
  estado    String
  notificar Boolean    @default(true)

  @@unique([rosterId, fecha])
}

// Asignación docente x sección x materia. UNA por (ciclo, sección, materia) (implica UNIQUE docente+seccion+materia). `heredada` = la materializó el
// perfil del docente (DocenteMateria x DocenteSeccion); `aulaElegidaId` = aula elegida entre las posibles (AsignacionAula) para esta materia.
model AcadAsignacion {
  id            String  @id @default(cuid()) @db.NVarChar(100)
  /// Las asignaciones son POR CICLO (una seccion cambia de docentes de un ano a otro).
  cicloId       String  @db.NVarChar(100)
  ciclo         Ciclo   @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  docenteId     String  @db.NVarChar(100)
  docente       Docente @relation(fields: [docenteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seccionId     String  @db.NVarChar(100)
  seccion       Seccion @relation(fields: [seccionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  materiaId     String  @db.NVarChar(100)
  materia       Materia @relation(fields: [materiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  heredada      Boolean @default(false)
  aulaElegidaId String? @db.NVarChar(100)
  aulaElegida   Aula?   @relation(fields: [aulaElegidaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aulas         AsignacionAula[]

  @@unique([cicloId, seccionId, materiaId])
  @@unique([cicloId, docenteId, seccionId, materiaId])
  @@index([materiaId])
  @@index([seccionId])
  @@index([docenteId])
  @@index([aulaElegidaId])
}

/// Aulas posibles de una asignación (vacío = aula base de la sección; la de menor `orden` es la predeterminada).
model AsignacionAula {
  asignacionId String         @db.NVarChar(100)
  asignacion   AcadAsignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  aulaId       String         @db.NVarChar(100)
  aula         Aula           @relation(fields: [aulaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orden        Int            @default(0)

  @@id([asignacionId, aulaId])
  @@index([aulaId])
}

// slot = 'dia-bloque' (ej. '0-1'): bloque de la grilla semanal. El aula de cada materia sale de su asignación (aulaElegidaId / AsignacionAula).
model AcadHorario {
  id        String  @id @default(cuid()) @db.NVarChar(100)
  /// El horario es POR CICLO.
  cicloId   String  @db.NVarChar(100)
  ciclo     Ciclo   @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seccionId String  @db.NVarChar(100)
  seccion   Seccion @relation(fields: [seccionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slot      String  @db.NVarChar(100)
  materiaId String  @db.NVarChar(100)
  materia   Materia @relation(fields: [materiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cicloId, seccionId, slot])
  @@index([materiaId])
  @@index([seccionId])
}

// Actividad extracurricular. `instructor` y `lugar` son el texto visible (pueden ser personas/espacios externos al colegio);
// `docenteId` / `aulaId` los enlazan con el Docente / Aula reales cuando coinciden. Los grados salen de AcadExtraGrado.
model AcadExtra {
  id         String   @id @db.NVarChar(100)
  name       String
  cat        String
  kind       String
  instructor String
  docenteId  String?  @db.NVarChar(100)
  docente    Docente? @relation(fields: [docenteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lugar      String
  aulaId     String?  @db.NVarChar(100)
  aula       Aula?    @relation(fields: [aulaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dias       String
  hora       String
  cupo       Int
  inscritos  Int      @default(0)
  costo      Float    @default(0)
  ini        String   @default("")
  sem        Int      @default(0)
  estado     String   @default("Abierta")
  grados     AcadExtraGrado[]
  servicios  ServicioAlumno[]

  @@index([docenteId])
  @@index([aulaId])
}

model AcadExtraGrado {
  extraId String    @db.NVarChar(100)
  extra   AcadExtra @relation(fields: [extraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gradoId String    @db.NVarChar(100)
  grado   Grado     @relation(fields: [gradoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([extraId, gradoId])
  @@index([gradoId])
}

// ---------- Personas (Directorio, Expediente 360, Inscripción) ----------
// Ficha JSON (ExpFicha) SIN contrato ni tutor legal: esos son Contrato y Alumno.tutorLegalId. Sin valor propio fuera del alumno: Cascade.
model PersExpediente {
  alumnoId String @id @db.NVarChar(100)
  alumno   Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  data     String @default("{}") @db.NVarChar(Max)
}

model PersDocumento {
  id       String @id @db.NVarChar(100)
  alumnoId String @db.NVarChar(100)
  alumno   Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// Tipo de documento (catalogo TipoDocumento); su nombre es el `n` que muestra la API.
  tipoId   String @db.NVarChar(100)
  tipo     TipoDocumento @relation(fields: [tipoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  f        String
  est      String // Validado | Pendiente | En revisión
  orden    Int    @default(0)

  @@unique([alumnoId, tipoId])
  @@index([alumnoId])
  @@index([tipoId])
}

/// Documentos que se piden en el expediente (acta de nacimiento, vacunas...). `requerido` = se exige al inscribir.
model TipoDocumento {
  id         String  @id @db.NVarChar(100)
  nombre     String  @unique @db.NVarChar(200)
  requerido  Boolean @default(true)
  orden      Int     @default(0)
  estado     String  @default("Activo")
  documentos PersDocumento[]
}

/// Servicio contratado por un alumno (antes PersServicio.catKey 'rt:'/'ali:'/'ext:'/'prd:'). Exactamente UNA de las cuatro FK de catalogo es no nula (CHECK
/// CK_ServicioAlumno_catalogo): ruta de transporte, plan de alimentacion, actividad extracurricular o producto del inventario.
model ServicioAlumno {
  id       String @id @db.NVarChar(100)
  alumnoId String @db.NVarChar(100)
  alumno   Alumno @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind     String // rec | once
  rutaId     String? @db.NVarChar(100)
  ruta       RutaTransporte? @relation(fields: [rutaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aliPlanId  String? @db.NVarChar(100)
  aliPlan    AliPlan? @relation(fields: [aliPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  extraId    String? @db.NVarChar(100)
  extra      AcadExtra? @relation(fields: [extraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productoId String? @db.NVarChar(100)
  producto   FinProducto? @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name     String
  icon     String @default("")
  spec     String @default("")
  cost     Float
  corte    String @default("")
  est      String @default("Activo") // Activo | Baja · dd/mm/aaaa
  alert    String @default("")
  fecha    String @default("") @db.NVarChar(100)
  st       String @default("") // once: cobrado | cargado | prog
  mes      String @default("")
  /// Recibo que cobró el servicio (once/cobrado); NULL = sin recibo.
  reciboId String? @db.NVarChar(100)
  recibo   FinRecibo? @relation(fields: [reciboId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cargos   FinCobroItem[]

  @@index([alumnoId])
  @@index([reciboId])
  @@index([rutaId])
  @@index([aliPlanId])
  @@index([extraId])
  @@index([productoId])
}

model PersInscripcion {
  id        String   @id @db.NVarChar(100)
  alumnoId  String   @db.NVarChar(100)
  alumno    Alumno   @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Ciclo en el que se inscribe (un alumno tiene a lo sumo UNA inscripcion por ciclo).
  cicloId   String   @db.NVarChar(100)
  ciclo     Ciclo    @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Evidencia fiscal de la inscripcion: el NCF es unico.
  ncf       String   @unique @db.NVarChar(100)
  factura   Float
  planId    String   @db.NVarChar(100)
  plan      FinPlan  @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cuotas    Int
  firma     String
  createdAt DateTime @default(now())

  @@unique([alumnoId, cicloId])
  @@index([planId])
  @@index([cicloId])
}

// Contrato de servicios educativos del alumno por ciclo (antes dentro de PersExpediente.data.contrato).
model Contrato {
  id       String  @id @db.NVarChar(100)
  alumnoId String  @db.NVarChar(100)
  alumno   Alumno  @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cicloId  String  @db.NVarChar(100)
  ciclo    Ciclo   @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planId   String  @db.NVarChar(100)
  plan     FinPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Tipo de beca del contrato (FK a TipoBeca). NULL = sin beca.
  tipoBecaId String? @db.NVarChar(100)
  tipoBeca   TipoBeca? @relation(fields: [tipoBecaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ctr      String  @default("")
  firmado  String  @default("")

  @@unique([alumnoId, cicloId])
  @@index([planId])
  @@index([tipoBecaId])
  @@index([cicloId])
}

// ---------- Catalogos de la Fase 2B (antes en Catalogo): TIPADOS, con los mismos ids de texto. Se DESACTIVAN (estado), no se borran con historial. ----------

/// Caja registradora (terminal logica de cobro). Estado: Activa | Inactiva.
model Caja {
  id        String @id @db.NVarChar(100)
  codigo    String @unique @db.NVarChar(100)
  ubic      String @default("") @db.NVarChar(300)
  /// Comprobante por defecto: «B02 · Consumo» | «B01 · Crédito fiscal».
  ncf       String @db.NVarChar(100)
  estado    String @default("Activa")
  empleados Empleado[]
  recibos   FinRecibo[]
  notas     NotaFiscal[]
}

model RutaTransporte {
  id        String @id @db.NVarChar(100)
  nombre    String @unique @db.NVarChar(200)
  sectores  String @default("") @db.NVarChar(500)
  chofer    String @default("")
  ficha     String @unique @db.NVarChar(100)
  asientos  Int
  /// Tarifa mensual (RD$).
  tarifa    Float
  estado    String @default("Activo")
  servicios ServicioAlumno[]
}

/// Tipo de beca. `pct` = porcentaje por defecto (0 = beca de monto fijo); `requiereAprobacion` = pasa por Direccion antes de aplicarse.
model TipoBeca {
  id                 String  @id @db.NVarChar(100)
  nombre             String  @unique @db.NVarChar(200)
  pct                Float   @default(0)
  requiereAprobacion Boolean @default(false)
  estado             String  @default("Activo")
  becas              FinBeca[]
  contratos          Contrato[]
}

model ConceptoBeca {
  id     String @id @db.NVarChar(100)
  nombre String @unique @db.NVarChar(200)
  estado String @default("Activo")
  becas  FinBecaConcepto[]
}

/// Conceptos que cubre una beca (N:M ordenado; reemplaza FinBeca.conceptos en texto).
model FinBecaConcepto {
  becaId     String       @db.NVarChar(100)
  beca       FinBeca      @relation(fields: [becaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conceptoId String       @db.NVarChar(100)
  concepto   ConceptoBeca @relation(fields: [conceptoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orden      Int          @default(0)

  @@id([becaId, conceptoId])
  @@index([conceptoId])
}

/// Medio de pago. `ref` = etiqueta de la referencia que se pide (NULL = no pide referencia, p. ej. Efectivo).
model MetodoPago {
  id      String  @id @db.NVarChar(100)
  nombre  String  @unique @db.NVarChar(200)
  ref     String? @db.NVarChar(200)
  estado  String  @default("Activo")
  recibos FinRecibo[]
  ventas  FinVenta[]
  pagos   FinReciboPago[]
  reembolsos NotaFiscalReembolso[]
}

model Comida {
  id     String @id @db.NVarChar(100)
  nombre String @unique @db.NVarChar(200)
  estado String @default("Activo")
  planes AliPlanComida[]
}

model Dieta {
  id     String @id @db.NVarChar(100)
  nombre String @unique @db.NVarChar(200)
  estado String @default("Activo")
  planes AliPlanDieta[]
}

model Alergia {
  id      String @id @db.NVarChar(100)
  nombre  String @unique @db.NVarChar(200)
  estado  String @default("Activo")
  alumnos AlumnoAlergia[]
  menus   AliMenuAlergia[]
}

/// Categoria de un producto del kiosko / inventario (Uniformes, Libros, Papelería, Servicios...).
model CategoriaProducto {
  id        String @id @db.NVarChar(100)
  nombre    String @unique @db.NVarChar(200)
  estado    String @default("Activo")
  productos FinProducto[]
}

/// Comidas que incluye un plan de alimentacion (reemplaza AliPlan.meals posicional).
model AliPlanComida {
  planId   String  @db.NVarChar(100)
  plan     AliPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  comidaId String  @db.NVarChar(100)
  comida   Comida  @relation(fields: [comidaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([planId, comidaId])
  @@index([comidaId])
}

/// Dietas que cubre un plan de alimentacion (reemplaza AliPlan.diets posicional).
model AliPlanDieta {
  planId  String  @db.NVarChar(100)
  plan    AliPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dietaId String  @db.NVarChar(100)
  dieta   Dieta   @relation(fields: [dietaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([planId, dietaId])
  @@index([dietaId])
}

/// Alergias del alumno (N:M). Cascade respecto del alumno (dato clinico sin valor propio fuera de el); NoAction hacia el catalogo.
model AlumnoAlergia {
  alumnoId  String  @db.NVarChar(100)
  alumno    Alumno  @relation(fields: [alumnoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alergiaId String  @db.NVarChar(100)
  alergia   Alergia @relation(fields: [alergiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([alumnoId, alergiaId])
  @@index([alergiaId])
}

/// Alergenos de un plato del menu semanal (reemplaza AliMenu.algs).
model AliMenuAlergia {
  menuOrden Int
  menu      AliMenu @relation(fields: [menuOrden], references: [orden], onDelete: Cascade, onUpdate: NoAction)
  alergiaId String  @db.NVarChar(100)
  alergia   Alergia @relation(fields: [alergiaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([menuOrden, alergiaId])
  @@index([alergiaId])
}

/// Cuadre (cierre) de turno de un cajero: congela lo cobrado entre `desde` y `hasta`. El turno siguiente del cajero arranca en `hasta` (GET /cobros/turno).
model CierreTurno {
  id              Int      @id @default(autoincrement())
  cajeroId        String   @db.NVarChar(100)
  cajero          User     @relation(fields: [cajeroId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Dia local (zona horaria del perfil) en que se hizo el cuadre, AAAA-MM-DD.
  fecha           String   @db.NVarChar(10)
  desde           DateTime
  hasta           DateTime
  caja            String?  @db.NVarChar(100)
  recibos         Int
  anulados        Int
  ventas          Int      @default(0)
  notas           Int      @default(0)
  bruto           Float
  devoluciones    Float
  neto            Float
  /// JSON {metodo: neto} (misma forma que CobroTurno.resumen.porMetodo).
  porMetodo       String   @db.NVarChar(Max)
  /// Efectivo contado fisicamente y diferencia contra el efectivo neto esperado (NULL si el cuadre no lo capturo).
  efectivoContado Float?
  diferencia      Float?
  createdAt       DateTime @default(now())

  @@index([cajeroId, hasta])
}

// ---------------------------------------------------------------------------------------------------------------------
// CIERRE DEL AÑO ESCOLAR Y PROMOCION DE CURSO (aditivo; ver docs/cierre-y-promocion.md)
//  - El cierre del ciclo es CONTABLE/ADMINISTRATIVO: congela el ciclo (solo lectura) y guarda aqui la foto de sus finanzas. NO promueve alumnos.
//  - La promocion de curso es un proceso SEPARADO basado en la Matriz de Notas (lib/promocion.ts); cada aplicacion deja su registro y el detalle por alumno.
// ---------------------------------------------------------------------------------------------------------------------
model CierreCiclo {
  id               Int      @id @default(autoincrement())
  /// Ciclo cerrado (uno solo: un ciclo se cierra una vez).
  cicloId          String   @unique @db.NVarChar(100)
  ciclo            Ciclo    @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Ciclo Planificado que quedo Activo con el cierre (NULL si no habia ninguno).
  cicloSiguiente   String?  @db.NVarChar(100)
  fecha            DateTime @default(now())
  /// Usuario (login) y nombre de quien ejecuto el cierre (instantanea).
  usuario          String   @db.NVarChar(100)
  usuarioNombre    String   @default("") @db.NVarChar(200)
  /// Totales RD$ del ciclo (definiciones en lib/ciclo-cierre.ts → resumenFinancieroCiclo).
  facturado        Float
  cobrado          Float
  notasCredito     Float
  notasDebito      Float
  cobradoNeto      Float
  descuentos       Float
  pendiente        Float
  vencido          Float
  mora             Float
  moraPendiente    Float
  recibos          Int
  recibosAnulados  Int
  cargos           Int
  cargosPendientes Int
  alumnosConDeuda  Int
  matriculas       Int
  /// JSON: deuda vigente por alumno al cerrar [{ alumnoId, code, nombre, seccion, pendiente, vencido, cargos }] (solo lectura, foto del cierre).
  deudaAlumnos     String   @db.NVarChar(Max)
}

model PromocionCiclo {
  id             Int      @id @default(autoincrement())
  cicloOrigenId  String   @db.NVarChar(100)
  cicloOrigen    Ciclo    @relation("PromocionOrigen", fields: [cicloOrigenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cicloDestinoId String   @db.NVarChar(100)
  cicloDestino   Ciclo    @relation("PromocionDestino", fields: [cicloDestinoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fecha          DateTime @default(now())
  usuario        String   @db.NVarChar(100)
  /// JSON con los parametros usados (CfgPromocion: notaMinima, criterio, maxReprobadas, requiereTodosLosPeriodos).
  parametros     String   @db.NVarChar(Max)
  evaluados      Int
  aprobados      Int
  reprobados     Int
  pendientes     Int
  graduados      Int
  sinSeccion     Int
  /// Matriculas creadas / reubicadas en el ciclo destino y alumnos sin cambios (ya estaban donde corresponde o se respeto su matricula).
  creadas        Int
  ajustadas      Int
  sinCambios     Int
  detalles       PromocionDetalle[]

  @@index([cicloOrigenId, fecha])
}

model PromocionDetalle {
  id               Int            @id @default(autoincrement())
  promocionId      Int
  promocion        PromocionCiclo @relation(fields: [promocionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alumnoId         String         @db.NVarChar(100)
  alumno           Alumno         @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Aprobado | Reprobado | Pendiente de notas
  resultado        String         @db.NVarChar(30)
  promedio         Float?
  reprobadas       Int            @default(0)
  /// Materias sin nota final completa (cuando el criterio exige todos los periodos).
  incompletas      Int            @default(0)
  seccionOrigenId  String         @db.NVarChar(100)
  /// Seccion asignada en el ciclo destino (NULL = sin seccion: graduado, pendiente de notas o sin cupo).
  seccionDestinoId String?        @db.NVarChar(100)
  /// Promovido | Repitente | Graduado | Pendiente | SinCupo | Respetada (matricula destino previa conservada)
  accion           String         @db.NVarChar(30)
  /// Creada | Ajustada | SinCambios | Retirada (que se hizo con la matricula del ciclo destino; Retirada = copia automatica de un graduado eliminada)
  matricula        String         @db.NVarChar(20)
  nota             String         @default("") @db.NVarChar(400)

  @@index([promocionId])
  @@index([alumnoId])
}

/// Historial de la REINSCRIPCION (Etapa B): una fila por hecho (Reserva, Confirmada, Liberada, Reactivada). Sin cascada (NoAction): es evidencia de auditoria.
model ReinscripcionEvento {
  id         Int      @id @default(autoincrement())
  cicloId    String   @db.NVarChar(100)
  ciclo      Ciclo    @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alumnoId   String   @db.NVarChar(100)
  alumno     Alumno   @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Reserva | Confirmada | Liberada | Reactivada
  tipo       String   @db.NVarChar(20)
  motivo     String   @default("")
  usuario    String   @default("sistema") @db.NVarChar(100)
  fecha      DateTime @default(now())
  seccionId  String?  @db.NVarChar(100)
  cargoId    String?  @db.NVarChar(100)

  @@index([cicloId, tipo])
  @@index([alumnoId])
}

/// Fecha limite de reinscripcion del ciclo destino (Etapa B): fecha ISO AAAA-MM-DD hasta la cual se paga la cuota de reinscripcion. Tabla aparte (no cambia Ciclo).
model CicloReinscripcion {
  cicloId String  @id @db.NVarChar(100)
  ciclo   Ciclo   @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  limite  String? @db.NVarChar(10)
}

/// Marca explicita de que una Matricula es una RESERVA creada por «Abrir reinscripcion» (1:1 con Matricula). La promocion la trata como reserva, no como copia automatica.
model ReinscripcionReserva {
  matriculaId String    @id @db.NVarChar(100)
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cicloId     String    @db.NVarChar(100)
  ciclo       Ciclo     @relation(fields: [cicloId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alumnoId    String    @db.NVarChar(100)
  alumno      Alumno    @relation(fields: [alumnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creada      DateTime  @default(now())

  @@unique([alumnoId, cicloId])
  @@index([cicloId])
}
