# Ejemplo SOLO con valores falsos. Copia a .env.local (ignorado por git) para desarrollo y
# configura los valores reales en Vercel (Settings > Environment Variables). NUNCA subas credenciales reales.

# --- Formulario de demo (api/solicitar-demo.ts) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Opcional. Si falta: true solo cuando SMTP_PORT=465.
SMTP_SECURE=false
SMTP_USER=usuario-smtp-de-ejemplo
SMTP_PASS=contrasena-de-ejemplo
DEMO_MAIL_FROM="STODIA Web <no-reply@example.com>"
# Uno o varios, separados por coma.
DEMO_MAIL_TO=ventas@example.com,soporte@example.com
# Opcional: copia oculta.
DEMO_MAIL_BCC=
# Opcional: 'true' envia acuse de recibo al solicitante.
DEMO_SEND_CONFIRMATION=false
# Opcional: origenes permitidos (coma). Por defecto https://stodia.vercel.app y el de VITE_SITE_URL.
ALLOWED_ORIGINS=
# Solo desarrollo: 'true' no envia nada y responde ok (se ignora en produccion).
SMTP_DRY_RUN=true

# --- Build de la landing ---
VITE_SITE_URL=https://stodia.vercel.app
# VITE_APP_URL=https://stodia.vercel.app/login
