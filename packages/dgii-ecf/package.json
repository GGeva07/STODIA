{
  "name": "@stodia/dgii-ecf",
  "version": "1.9.1-stodia.0",
  "private": true,
  "description": "Fork interno de dgii-ecf (victors1681/dgii-ecf): firma XMLDSig, autenticacion y envio de e-CF a la DGII. SOLO BACKEND: contiene logica de certificado y clave privada; la web NUNCA debe importarlo.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "check:aislamiento": "node scripts/check-aislamiento.mjs",
    "test": "pnpm run test:offline",
    "test:all": "jest --config ./jest.config.js",
    "test:offline": "jest --config ./jest.config.js --testPathPattern \"(utils|transformers|customAuthentication|Signature/__tests__/Signature.arbitrary|networking/__tests__/DgiiApiError)\""
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "axios": "1.20.0",
    "busboy": "1.6.0",
    "dotenv": "16.0.3",
    "form-data": "4.0.6",
    "jsonwebtoken": "9.0.2",
    "node-forge": "1.4.0",
    "stream-length": "1.0.2",
    "string-to-file-stream": "2.0.0",
    "xml-crypto": "6.1.2",
    "xml-js": "1.6.11",
    "xpath": "0.0.32"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/jest": "29.2.4",
    "@types/jsonwebtoken": "9.0.8",
    "@types/node": "20.17.6",
    "@types/node-forge": "1.3.1",
    "axios-mock-adapter": "1.21.2",
    "jest": "29.3.1",
    "jest-extended": "4.0.2",
    "ts-jest": "29.0.3",
    "typescript": "5.9.3"
  }
}
